# encino_orm - variables de entorno de EJEMPLO
#
# ADVERTENCIA: credenciales SOLO para desarrollo local. Todos los valores de
# este archivo son desechables (de juguete) y coinciden con docker-compose.yml;
# NUNCA los uses en produccion. Sustituyelos por secretos gestionados
# (variables de entorno del despliegue o un gestor de secretos).
#
# Copia este archivo a `.env` (ignorado por git) y ajusta los valores si lo
# necesitas. Los tests los leen con los defaults de docs/docker.md.
# Referencia: docs/docker.md > "Variables de entorno".

# --- MySQL (tests/test_mysql.py) ---
ENCINO_ORM_MYSQL_HOST=127.0.0.1
ENCINO_ORM_MYSQL_PORT=3306
ENCINO_ORM_MYSQL_USER=root
ENCINO_ORM_MYSQL_PASSWORD=admin
ENCINO_ORM_MYSQL_DB=encino_orm_test

# --- MariaDB (tests/test_mariadb.py) ---
ENCINO_ORM_MARIADB_HOST=127.0.0.1
ENCINO_ORM_MARIADB_PORT=3306
ENCINO_ORM_MARIADB_USER=root
ENCINO_ORM_MARIADB_PASSWORD=admin
ENCINO_ORM_MARIADB_DB=encino_orm_test

# --- PostgreSQL (tests/test_postgresql.py) ---
ENCINO_ORM_POSTGRES_HOST=127.0.0.1
ENCINO_ORM_POSTGRES_PORT=5432
ENCINO_ORM_POSTGRES_USER=postgres
ENCINO_ORM_POSTGRES_PASSWORD=admin
ENCINO_ORM_POSTGRES_DB=encino_orm_test

# --- SQL Server (tests/test_mssql.py) ---
# DRIVER requiere "ODBC Driver 18 for SQL Server" instalado en el host.
ENCINO_ORM_MSSQL_HOST=127.0.0.1
ENCINO_ORM_MSSQL_PORT=1433
ENCINO_ORM_MSSQL_USER=sa
ENCINO_ORM_MSSQL_PASSWORD=Admin_123
ENCINO_ORM_MSSQL_DB=encino_orm_test
ENCINO_ORM_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
ENCINO_ORM_MSSQL_TRUST_CERT=true

# --- Oracle (tests/test_oracle.py) ---
ENCINO_ORM_ORACLE_HOST=127.0.0.1
ENCINO_ORM_ORACLE_PORT=1521
ENCINO_ORM_ORACLE_SERVICE=XEPDB1
ENCINO_ORM_ORACLE_USER=system
ENCINO_ORM_ORACLE_PASSWORD=admin

# --- Redis (tests/test_redis_cache.py) ---
ENCINO_ORM_REDIS_URL=redis://127.0.0.1:6379
