# name: test_insert_replace_with_conflict_snapshot
  dict({
    'mariadb': dict({
      'sql': 'REPLACE INTO t (a,b) VALUES (%s,%s)',
      'values': list([
        1,
        'x',
      ]),
    }),
    'mssql': dict({
      'sql': 'MERGE INTO t AS dst USING (SELECT ? AS a, ? AS b) AS src ON (dst.b = src.b) WHEN MATCHED THEN UPDATE SET dst.a = src.a, dst.b = src.b WHEN NOT MATCHED THEN INSERT (a,b) VALUES (src.a,src.b)',
      'values': list([
        1,
        'x',
      ]),
    }),
    'mysql': dict({
      'sql': 'REPLACE INTO t (a,b) VALUES (%s,%s)',
      'values': list([
        1,
        'x',
      ]),
    }),
    'oracle': dict({
      'sql': 'MERGE INTO t dst USING (SELECT :parameter_0000 AS a, :parameter_0001 AS b) src ON (dst.b = src.b) WHEN MATCHED THEN UPDATE SET dst.a = src.a, dst.b = src.b WHEN NOT MATCHED THEN INSERT (a,b) VALUES (src.a,src.b)',
      'values': dict({
        'parameter_0000': 1,
        'parameter_0001': 'x',
      }),
    }),
    'postgresql': dict({
      'sql': 'INSERT INTO t (a,b) VALUES ($1,$2) ON CONFLICT (b) DO UPDATE SET a = EXCLUDED.a, b = EXCLUDED.b',
      'values': list([
        1,
        'x',
      ]),
    }),
    'sqlite': dict({
      'sql': 'INSERT OR REPLACE INTO t (a,b) VALUES (?,?)',
      'values': list([
        1,
        'x',
      ]),
    }),
  })
