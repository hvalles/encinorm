# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Pruebas y cobertura
.pytest_cache/
# El glob es necesario: con `parallel = true` coverage escribe un artefacto por
# pata (`.coverage.py3.10`, o `.coverage.py3.10.<host>.<pid>.<rand>` cuando
# aplica el sufijo paralelo), y la entrada exacta `.coverage` NO los captura.
.coverage*
htmlcov/
# Reporte JSON que alimenta el gate de pisos por modulo
# (tools/ci/check_coverage_floors.py); se genera en el job `coverage`.
coverage.json
# Reportes generados localmente (`coverage xml`, `pytest --junitxml`); en CI
# son artefactos, no fuentes.
coverage.xml
junit.xml

# Documentación generada
site/

# Entornos / editores
.env
.idea/
.vscode/

# Notas internas (no distribuir)
prompts/

# SQLITE
*.db-*
